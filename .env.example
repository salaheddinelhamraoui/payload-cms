# A generated secret for Payload
PAYLOAD_SECRET=

# Origin of the public site. Used for the admin "Preview" button, and as the
# allow-list for CORS and CSRF.
FRONTEND_URL=https://devora-tv.com

# Where to send a cache-purge request when a post is published or changed, and
# the shared secret that endpoint checks. Leave both unset in development —
# the hook then logs and skips instead of failing the save.
FRONTEND_REVALIDATE_URL=https://devora-tv.com/api/revalidate
FRONTEND_REVALIDATE_SECRET=
